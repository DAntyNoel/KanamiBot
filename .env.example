DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=12706

NAPCAT_WORKDIR=files/napcat_runtime
NAPCAT_WEBUI_HOST=127.0.0.1
NAPCAT_WEBUI_PORT=12705
NAPCAT_WEBUI_TOKEN=change-me

# Allow both "/ping" and "ping" style commands.
COMMAND_START=["/", ""]

# DEBUG enables per-component [timing] records in the console; INFO disables them.
LOG_LEVEL=INFO

# Keep this value identical to NapCat's websocket client token.
ONEBOT_ACCESS_TOKEN=change-me

# Fill with your own QQ number(s) as strings when privileged commands are added.
SUPERUSERS=["123456789"]

# Codex GPT plugin. Leave API key blank until you enable the plugin.
CODEX_GPT_API_KEY=
CODEX_GPT_BASE_URL=https://cliproxyapi-dantynoel.onrender.com/v1
CODEX_GPT_MODEL=gpt-5.5
CODEX_GPT_IMAGE_MODEL=gpt-image-2
CODEX_GPT_IMAGE_MAX_CONTEXT_CHARS=4000
CODEX_GPT_ACTIVE_REPLY=false

# GPT-SoVITS TTS plugin is migrated but disabled by default.
KANAMIBOT_TTS_ENABLED=false
GPT_SOVITS_URL=http://127.0.0.1
GPT_SOVITS_PORT=9550
GPT_SOVITS_PROJECT_ROOT=
GPT_SOVITS_PYTHON_EXEC=
GPT_SOVITS_GPT_MODEL_PATH=
GPT_SOVITS_SOVITS_MODEL_PATH=

# Strinova tracker: enabled by default; all queries pause while /health is unavailable.
KANAMIBOT_STRINOVA_ENABLED=true
# Prefer localhost; fall back to http://10.38.20.220:19080 when unavailable.
STRINOVA_API_URL=http://127.0.0.1:19080
# Optional X-API-Key, also sent to /health. Never put it in the API URL.
STRINOVA_API_KEY=
STRINOVA_API_TIMEOUT=90
# Optional installed browser channel: chrome or msedge; otherwise use Playwright Chromium.
STRINOVA_BROWSER_CHANNEL=
STRINOVA_BROWSER_EXECUTABLE=
# Local resources/fonts live in src/kanamibot/plugins/strinova/resources/ (gitignored).
# Avatars prefer the local pack; this URL template is the fallback, using numeric {icon}.
# Empty uses the public StrinovaData mirror; fallback cache stays under the plugin's cache/avatars/.
STRINOVA_AVATAR_URL_TEMPLATE=

# Skland is loaded by the local adapter from its pinned Git submodule.
KANAMIBOT_SKLAND_ENABLED=true
# Global account signing; independent of per-group enable/disable skland.
KANAMIBOT_SKLAND_AUTO_SIGN=true
SKLAND__AUTO_UPDATE_RESOURCES=true
SKLAND__CHECK_RES_UPDATE=false
SKLAND__ENDFIELD_BACKGROUND_SIMPLE=false
SKLAND__EF_GACHA_RENDER_MAX=5

# Reverse image search: quote an image and send #搜图. No API keys required.
IMAGE_SEARCH_ENABLED=true
IMAGE_SEARCH_ENGINES=["lens","saucenao","tracemoe"]
IMAGE_SEARCH_TIMEOUT=45
IMAGE_SEARCH_MAX_ACCOUNTS=3
IMAGE_SEARCH_STRICT_CONSENSUS=true
IMAGE_SEARCH_INFER_ACCOUNTS=true
# Only the search browser uses this proxy; system proxy settings are never changed.
IMAGE_SEARCH_PROXY=
# Empty executable/channel selects project-managed Chromium, then Playwright's default.
IMAGE_SEARCH_BROWSER_CHANNEL=
# Absolute path or path relative to this project; overrides the managed browser.
IMAGE_SEARCH_BROWSER_EXECUTABLE=
# Lens login helper exchanges cookies with the running search browser through this file.
IMAGE_SEARCH_COOKIE_FILE=data/image_search/google_cookies.json
# Optional copied Google Cookie header, used only if no cookie file exists.
IMAGE_SEARCH_GOOGLE_COOKIE=
IMAGE_SEARCH_FOUND_IMAGE=
IMAGE_SEARCH_SEND_ON_MISS=false
IMAGE_SEARCH_COOLDOWN=30
IMAGE_SEARCH_PER_USER_DAY=20
IMAGE_SEARCH_GLOBAL_DAY=100
IMAGE_SEARCH_CACHE_DAYS=30
IMAGE_SEARCH_CACHE_MAX=500
# Optional Litterbox upload (1 hour) for URL-only engines. Disabled by default.
IMAGE_SEARCH_PUBLIC_UPLOAD=false
# ESBR plugin. Point this to the erbs executable when it is not on PATH.
ERBS_EXECUTABLE=erbs
# Optional project root used to discover downloaded ERBS image assets.
ERBS_WORKDIR=

# Image classification (CPU ONNX). Prepare models before enabling on the bot host.
IMAGE_CLASSIFIER_ENABLED=true
# Models can be disabled independently; disabled models are not loaded.
IMAGE_CLASSIFIER_ANIME_ENABLED=true
IMAGE_CLASSIFIER_ANIME_REAL_ENABLED=true
IMAGE_CLASSIFIER_NSFW_ENABLED=true
# Defaults: data/image_classifier/models and data/image_classifier/tmp
# IMAGE_CLASSIFIER_MODEL_DIR=/path/to/models
# IMAGE_CLASSIFIER_CACHE_DIR=/path/to/tmp
# Classification uses the fixed A1-A3 / B1-B3 rules documented in the plugin README.
IMAGE_CLASSIFIER_CPU_THREADS=2
IMAGE_CLASSIFIER_QUEUE_SIZE=512
IMAGE_CLASSIFIER_MAX_DOWNLOAD_MB=20
IMAGE_CLASSIFIER_MAX_PIXELS=25000000
IMAGE_CLASSIFIER_ANIMATION_SAMPLES=8
# Only reuse local images under explicitly trusted roots (JSON array; forward slashes on Windows).
IMAGE_CLASSIFIER_LOCAL_ROOTS=[]
IMAGE_CLASSIFIER_PREVIEW_DIMENSIONS=["anime","real","unknown"]
IMAGE_CLASSIFIER_PREVIEW_SAFETY=["normal","suggestive","nsfw","unknown"]
IMAGE_CLASSIFIER_PREVIEW_CATEGORIES_A=["A1","A2","A3"]
IMAGE_CLASSIFIER_PREVIEW_CATEGORIES_B=["B1","B2","B3","unknown"]
IMAGE_CLASSIFIER_PREVIEW_PAGE_SIZE=20
IMAGE_CLASSIFIER_INFERENCE_CACHE_SIZE=512
