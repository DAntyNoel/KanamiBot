DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=12706

NAPCAT_WORKDIR=files/napcat_runtime
NAPCAT_WEBUI_HOST=127.0.0.1
NAPCAT_WEBUI_PORT=12705
NAPCAT_WEBUI_TOKEN=change-me

# Allow both "/ping" and "ping" style commands.
COMMAND_START=["/", ""]

LOG_LEVEL=INFO

# Keep this value identical to NapCat's websocket client token.
ONEBOT_ACCESS_TOKEN=change-me

# Fill with your own QQ number(s) as strings when privileged commands are added.
SUPERUSERS=["123456789"]

# Codex GPT plugin. Leave API key blank until you enable the plugin.
CODEX_GPT_API_KEY=
CODEX_GPT_BASE_URL=https://cliproxyapi-dantynoel.onrender.com/v1
CODEX_GPT_MODEL=gpt-5.5
CODEX_GPT_IMAGE_MODEL=gpt-image-2
CODEX_GPT_IMAGE_MAX_CONTEXT_CHARS=4000
CODEX_GPT_ACTIVE_REPLY=false

# GPT-SoVITS TTS plugin is migrated but disabled by default.
KANAMIBOT_TTS_ENABLED=false
GPT_SOVITS_URL=http://127.0.0.1
GPT_SOVITS_PORT=9550
GPT_SOVITS_PROJECT_ROOT=
GPT_SOVITS_PYTHON_EXEC=
GPT_SOVITS_GPT_MODEL_PATH=
GPT_SOVITS_SOVITS_MODEL_PATH=

# ESBR plugin. Point this to the erbs executable when it is not on PATH.
ERBS_EXECUTABLE=erbs
# Optional project root used to discover downloaded ERBS image assets.
ERBS_WORKDIR=

# Strinova tracker: enabled by default; all queries pause while /health is unavailable.
KANAMIBOT_STRINOVA_ENABLED=true
STRINOVA_API_URL=http://10.38.20.220:19080
STRINOVA_API_TIMEOUT=35
# Optional installed browser channel: chrome or msedge; otherwise use Playwright Chromium.
STRINOVA_BROWSER_CHANNEL=
STRINOVA_BROWSER_EXECUTABLE=
# Local resources/fonts live in src/kanamibot/plugins/strinova/resources/ (gitignored).
# Avatars prefer the local pack; this URL template is the fallback, using numeric {icon}.
# Empty uses the public StrinovaData mirror; fallback cache stays under the plugin's cache/avatars/.
STRINOVA_AVATAR_URL_TEMPLATE=
